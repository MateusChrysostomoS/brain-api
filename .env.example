# --- Application ---
APP_ENV=dev
LOG_LEVEL=INFO

# --- Database (asyncpg driver) — brain's own database in the shared Postgres ---
DATABASE_URL=postgresql+asyncpg://brain:brain@localhost:5432/brain

# --- JWT (identity authority) ---
# HS256 signing key. SHARED mesh secret (precheck verifies brain tokens with the
# same key). Generate with: openssl rand -hex 64
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_64
# Rotation window ONLY (docs/key-rotation.md): the previous SECRET_KEY, accepted for
# verification while already-issued tokens age out. Leave empty otherwise.
SECRET_KEY_PREVIOUS=
# Access-token lifetime in minutes (keep short — the refresh token is the long leg).
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh-token lifetime in days (stored hashed, rotated on every use, revocable).
REFRESH_TOKEN_EXPIRE_DAYS=14
# Max /auth/token + /auth/refresh attempts per IP per minute (0 disables).
AUTH_RATE_LIMIT_PER_MIN=10
# Lifetime of the minted PreCheck SSO handoff token (POST /sso/precheck/token).
PRECHECK_TOKEN_EXPIRE_MINUTES=60
# Lifetime of the tenant-scoped secretarIA hub token (POST /doctor/secretaria/hub-token).
HUB_TOKEN_EXPIRE_MINUTES=60

# --- CORS (the Next.js Brain portal) ---
# Comma-separated list of allowed browser origins.
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Demo request anti-spam ---
DEMO_RATE_LIMIT_PER_MIN=5

# --- Platform admin bootstrap (scripts/seed_admin.py) ---
# The single platform admin seeded into a fresh DB (role=admin, tenant_id=NULL).
# Read ONLY from the environment; the password is bcrypt-hashed on insert, never stored
# in code or logged. The seed is idempotent (skips if the email already exists).
ADMIN_EMAIL=admin@brain.co
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# --- Admin "Modo médico" impersonation (POST /admin/impersonate/token, CONTRACTS §11.4) ---
# Clinic (tenant) owner the admin header's "Modo médico" switch enters, so an admin can use
# the doctor portal + PreCheck/secretarIA with real data while developing. Must be a
# tenant_owner/tenant_staff that carries a tenant_id (else the endpoint returns 404).
# Defaults to the seeded dev clinic; in production point it at a real sandbox clinic owner.
IMPERSONATION_DEMO_EMAIL=dra.demo@clinica.com.br

# --- Service-to-service: BFF proxy into PreCheck ---
# Base URL of the PreCheck backend (e.g. http://precheck:8000 on the internal network).
# Empty disables the upstream call: admin "inbound" + doctor "anamneses" then return an
# empty page locally. brain-api forwards the caller's brain JWT (precheck validates it).
PRECHECK_BASE_URL=
# Timeout (seconds) for the precheck proxy client.
PRECHECK_TIMEOUT_SECONDS=10
# PreCheck's internal/n8n token (X-Internal-Token). A DIFFERENT mechanism from the
# forwarded-brain-JWT proxy above (a service credential, not the caller's token). Used for:
#   * the LGPD privacy orchestration (POST /admin/privacy/erasure|export ->
#     PreCheck /api/v1/internal/privacy/*). Empty here -> the precheck leg of an
#     erasure/export reports "skipped_unconfigured" (the rest still runs).
#   * the secretarIA -> brain-api -> PreCheck patient handoff (POST
#     /internal/precheck-handoff -> PreCheck /internal/precheck-handoff, CONTRACTS §12.3).
#     Empty here (or PRECHECK_BASE_URL empty) -> 503 precheck_handoff_not_configured
#     (fails LOUD, never degrades — a handoff that silently doesn't happen is worse than
#     a loud failure).
# NEVER log it.
PRECHECK_INTERNAL_TOKEN=

# --- Service-to-service: secretaria (internal-only) ---
# Base URL of secretaria on the internal network (e.g. http://secretaria:8000). Empty in
# dev → /doctor/appointments + /doctor/patients return an empty page (no upstream call).
SECRETARIA_BASE_URL=
# ACTIVE: X-Internal-Api-Key for brain-api -> secretaria /internal/* (doctor appointments
# + patients). MUST equal secretaria's OWN INTERNAL_API_KEY byte-for-byte, else secretaria
# returns 401/403 and brain-api surfaces 502. Generate a random machine secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Empty here fails closed to an empty page. NEVER log it. Different from SECRETARIA_ADMIN_TOKEN below.
# This SAME pair key also guards brain-api's own inbound /internal/* surface (secretarIA
# introspecting hub tokens / reading entitlement summaries) — one secret, both directions.
SECRETARIA_API_KEY=
# Rotation window ONLY: the previous pair key, accepted for INBOUND verification while
# both services flip to the new value (docs/key-rotation.md). Leave empty otherwise.
SECRETARIA_API_KEY_PREVIOUS=

# --- secretaria admin (cross-API into secretaria's /admin/*) ---
# secretaria has NO user/role system; its only privileged surface is /admin/*, guarded by
# the X-Admin-Token header checked against secretaria's OWN ADMIN_TOKEN env var. This is a
# DIFFERENT mechanism from INTERNAL_API_KEY above, so it needs its own value. It MUST equal
# secretaria's ADMIN_TOKEN byte-for-byte or secretaria returns 403; empty here fails closed
# (brain-api raises 503 before any call). Guards a DESTRUCTIVE wipe endpoint — NEVER log it.
SECRETARIA_ADMIN_TOKEN= 
# Timeout (seconds) for the secretaria admin client.
SECRETARIA_TIMEOUT_SECONDS=10

# --- Stripe billing (stripe-billing-entitlements) ---
# Secret API key (sk_test_... in sandbox, sk_live_... in production). Empty disables
# the billing endpoints (503) — entitlement READS never touch Stripe either way.
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_...) for POST /webhooks/stripe. Empty fails CLOSED
# (every delivery rejected with 400). From the Stripe dashboard's webhook endpoint.
STRIPE_WEBHOOK_SECRET=
# JSON: catalog id (services/catalog.py plans + add-ons) -> Stripe price id, per
# environment. The key "secretaria_ferro" is accepted as an alias for secretaria_basico
# (LEGACY_PLAN_ALIASES) — a not-yet-migrated deployed map may still use it.
# secretaria_basico is FULLY METERED (no flat/anchor price of its own, single plan since
# the 2026-07-22 ferro/bronze_1/bronze_2 tier-ladder retirement): add its THREE companion
# keys "{plan_id}_metered_patients" / "{plan_id}_metered_professionals" /
# "{plan_id}_metered_reminders" (R$2/billable-patient, R$80/active-professional,
# R$.../reminder sent outside the 24h window) instead of a plain "secretaria_basico"
# entry. The superseded single "secretaria_basico_metered" key is still tolerated
# (recognized-but-unused) if a not-yet-migrated map still has it, but no code path reads
# it anymore. Example:
#   {"secretaria_basico_metered_patients":"price_...","secretaria_basico_metered_professionals":"price_...","secretaria_basico_metered_reminders":"price_...","precheck":"price_...","complete_clinic_combo":"price_...","reactivation_pack":"price_...","verified_identity":"price_...","multi_professional":"price_...","multi_unit":"price_...","ehr":"price_...","pix_deposit":"price_...","analytics_bi":"price_...","analytics_bi_advanced":"price_...","human_backup_24_7":"price_..."}
STRIPE_PRICE_MAP={}
# Where Checkout / the Billing Portal send the browser afterwards.
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/app?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/app?checkout=cancelled
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/app
# Cold-signup (public landing page) checkouts return to a PUBLIC onboarding page —
# the buyer has no session yet, so /app would bounce them to /login. Empty = fall
# back to the shared URLs above. Keep Stripe's {CHECKOUT_SESSION_ID} template in the
# success URL: /checkout/sucesso polls GET /public/onboarding-status with it.
# Production example:
#   STRIPE_SIGNUP_CHECKOUT_SUCCESS_URL=https://<frontend-domain>/checkout/sucesso/?session_id={CHECKOUT_SESSION_ID}
#   STRIPE_SIGNUP_CHECKOUT_CANCEL_URL=https://<frontend-domain>/checkout/cancelado/
STRIPE_SIGNUP_CHECKOUT_SUCCESS_URL=
STRIPE_SIGNUP_CHECKOUT_CANCEL_URL=
# Trial length (days) applied to every subscription-mode Checkout Session. 0/empty =
# off. Deploy sets this high enough (e.g. ~75) to outlast the onboarding retry window
# before Stripe would otherwise charge a still-unconnected tenant (harden_charge ends
# the trial early once the tenant reaches 'ativo', regardless of this value).
STRIPE_TRIAL_PERIOD_DAYS=0
# Stripe Meter event_name for the billable_patients metered add-on price
# (services/usage.py forwards a meter event after a successful billable_patients usage
# record when this AND the tenant's stripe_customer_id are both set). Empty disables
# the forward entirely (metering-only, no billing impact either way).
STRIPE_METER_EVENT_BILLABLE_PATIENTS=
# Stripe Meter event_name for the active_professionals metered PLAN price (the
# fully-metered secretaria_basico model, R$80/active-professional/month). Same
# forward/fail-soft contract as STRIPE_METER_EVENT_BILLABLE_PATIENTS above. Empty
# disables the forward entirely (metering-only, no billing impact either way).
STRIPE_METER_EVENT_ACTIVE_PROFESSIONALS=
# Stripe Meter event_name for the reminders metered PLAN price (24h/1h appointment
# reminders sent OUTSIDE the WhatsApp 24h window — the third leg of the fully-metered
# secretaria_basico model). Same forward/fail-soft contract as
# STRIPE_METER_EVENT_BILLABLE_PATIENTS above. Empty disables the forward entirely
# (metering-only, no billing impact either way).
STRIPE_METER_EVENT_REMINDERS=

# --- Onboarding / multi-professional (CONTRACT_onboarding_v1.md) ---
# Meta Graph API app credentials for the WhatsApp Embedded Signup authorization-code
# exchange (POST /doctor/onboarding/attempts). Empty -> the exchange is skipped/fails
# soft (a 'fail' attempt with error_code="token_exchange_failed"), never a 500.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_BASE_URL=https://graph.facebook.com/v23.0
# Meta Embedded Signup config id. The FRONTEND needs its own copy
# (NEXT_PUBLIC_META_APP_ID / NEXT_PUBLIC_META_ES_CONFIG_ID); this is the backend's copy,
# surfaced read-only via GET /doctor/onboarding's `embedded_signup` block. Not a secret.
META_ES_CONFIG_ID=
# Base URL of the brain-frontend portal — builds the professional-invite link
# ("{FRONTEND_BASE_URL}/convite?token=...", POST /doctor/professionals/invites).
FRONTEND_BASE_URL=http://localhost:3000
# Fallback (hours) for the ativo transition when secretaria's Coexistence "mode
# resolved" signal never arrives: a tenant whose WhatsApp connected_at is older than
# this is treated as mode-resolved anyway, so a stalled signal can never permanently
# block activation.
MODE_RESOLVE_FALLBACK_HOURS=24
# Throttle (seconds) for the config-status pull from secretaria (in-process TTL cache,
# services/onboarding_sync.py) — GET /doctor/onboarding / GET /doctor/professionals
# refresh at most once per this many seconds per tenant.
CONFIG_STATUS_PULL_TTL_SECONDS=60
# Lifetime (hours) of a professional-invite token (POST /doctor/professionals/invites ->
# POST /auth/exchange-invite-token). Hashed at rest, single-use, same scheme as the
# onboarding token.
INVITE_TOKEN_EXPIRE_HOURS=72
