{"nodes": [{"id": "key-rotation_doc", "label": "Mesh secret rotation \u2014 zero-downtime procedures doc", "file_type": "document", "source_file": "docs/key-rotation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "key-rotation_previous_window", "label": "*_PREVIOUS verify-only rotation window", "file_type": "rationale", "source_file": "docs/key-rotation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each long-lived mesh secret has a *_PREVIOUS companion accepted for VERIFICATION only, so the two sides of an invariant flip one deploy at a time with zero downtime; minting/sending always uses the current value. The slot is a window, not a second permanent key \u2014 clearing it is part of the procedure. PreCheck notably has NO previous-key fallback, which forces the ordered two-deploy SECRET_KEY procedure. Refresh tokens are opaque DB rows, not JWTs, so they survive a SECRET_KEY rotation and let the portal recover seamlessly."}], "edges": [{"source": "key-rotation_doc", "target": "contracts_doc", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/key-rotation.md", "source_location": null, "weight": 1.0}, {"source": "key-rotation_previous_window", "target": "contracts_shared_secret_key", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/key-rotation.md", "source_location": "\u00a71", "weight": 1.0}, {"source": "key-rotation_previous_window", "target": "contracts_secretaria_pair_key", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/key-rotation.md", "source_location": "\u00a72", "weight": 1.0}, {"source": "key-rotation_previous_window", "target": "contracts_secretaria_admin_connection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/key-r